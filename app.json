{
  "expo": {
    "name": "SawahArtha",
    "slug": "SawahArtha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "sawahartha",
      "com.gentur.ariya.SawahArtha"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.gentur.ariya.SawahArtha",
      "config": {
        "googleMaps": {
          "apiKey": ""
        }
      }
    },
    "web": {
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 400,
          "resizeMode": "cover",
          "backgroundColor": "#E6F4FE"
        }
      ],
      "expo-router",
      "expo-sqlite",
      "expo-status-bar",
      "expo-sharing",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "color": "#059669",
          "defaultChannel": "reminders"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Aplikasi memerlukan akses galeri untuk melampirkan foto struk dan dokumentasi sawah.",
          "cameraPermission": "Aplikasi memerlukan akses kamera untuk memindai struk dan mengambil foto progress tanaman."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Aplikasi memerlukan akses kamera untuk memindai struk belanja."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Aplikasi memerlukan akses galeri untuk menyimpan foto dokumentasi sawah.",
          "savePhotosPermission": "Aplikasi memerlukan izin untuk menyimpan foto."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Aplikasi memerlukan akses lokasi untuk menandai posisi sawah Anda.",
          "locationWhenInUsePermission": "Aplikasi memerlukan akses lokasi untuk menandai posisi sawah Anda."
        }
      ],
      "expo-splash-screen"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f24ebb2f-7efc-4558-b8da-40e19ccf8102"
      },
      "googleDriveClientIds": {
        "android": "887102570827-5nt3ig29rf7i854lq4adouhqp3lggeti.apps.googleusercontent.com",
        "ios": "",
        "web": ""
      }
    }
  }
}
